# Salin ke .env di VPS (di samping docker-compose.yml). Semua variabel web lain: lihat web/.env.example.
DOMAIN=                         # contoh stasiun.example.com; DNS A-record harus sudah mengarah ke VPS
WEB_TAG=latest                  # tag image GHCR: latest, sha-xxxxxxx, atau versi (1.0.0)

DATABASE_URL=                   # runtime; Supabase transaction pooler (6543) boleh
DATABASE_MIGRATE_URL=           # opsional; koneksi session/direct (5432) untuk migrasi saat container start
ADMIN_PASSWORD=                 # string acak panjang (openssl rand -base64 32)
DEVICE_ID=stasiun-01
BMKG_ADM4=
BMKG_SLOT_MODE=start
PREDICT_THRESHOLD=50
RAIN_MIN_WET_MINUTES=10
CALIB_START=
CALIB_END=
EVAL_START=
EVAL_END=
DEVICE_OFFLINE_AFTER_SEC=30
DISABLE_JOBS=
