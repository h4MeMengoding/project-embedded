{
  "name": "weather-station-web",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @ws/web",
    "dev": "npm run dev -w @ws/web",
    "calib:report": "npm run report -w @ws/calibration --",
    "device:create": "npm run device:create -w @ws/db --"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
