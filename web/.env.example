# Supabase dev (session pooler 5432 untuk migrasi; runtime boleh 6543 dengan prepare:false)
DATABASE_URL=
DEVICE_ID=stasiun-01
# Kode wilayah BMKG cadangan. Normalnya disetel di /pengaturan (disimpan di database). Kosong -> 'SEED'. JANGAN ditebak.
BMKG_ADM4=
# Password halaman /pengaturan (kosong = pengaturan tidak bisa diubah). Pakai string acak panjang.
ADMIN_PASSWORD=
# 1 = matikan cron BMKG (menit 5) dan evaluasi (menit 10) di proses web
DISABLE_JOBS=
# start (default) atau center
BMKG_SLOT_MODE=start
PREDICT_THRESHOLD=50
RAIN_MIN_WET_MINUTES=10
# ISO dengan zona, contoh 2026-11-20T00:00:00+07:00
# Periode kalibrasi (1-2 hari pertama): parameter fuzzy hanya boleh disetel dari periode ini,
# dan slot di dalamnya tidak dihitung pada metrik. CALIB_END harus <= EVAL_START.
CALIB_START=
CALIB_END=
EVAL_START=
EVAL_END=
# ESP mengirim nilai live lewat WebSocket tiap 1 detik; offline jika tidak ada kabar selama ini (detik)
DEVICE_OFFLINE_AFTER_SEC=30
