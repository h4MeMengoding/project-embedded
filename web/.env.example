# Supabase dev (session pooler 5432 untuk migrasi; runtime boleh 6543 dengan prepare:false)
DATABASE_URL=
DEVICE_ID=stasiun-01
# Kode wilayah BMKG. Kosong -> 'SEED'. JANGAN ditebak.
BMKG_ADM4=
# start (default) atau center
BMKG_SLOT_MODE=start
PREDICT_THRESHOLD=50
RAIN_MIN_WET_MINUTES=10
# ISO dengan zona, contoh 2026-11-20T00:00:00+07:00
EVAL_START=
EVAL_END=
DEVICE_OFFLINE_AFTER_SEC=180
# wss://domain/ws/live (kosong -> polling /api/live)
PUBLIC_WS_URL=
